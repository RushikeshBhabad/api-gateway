{
  "name": "bookstore-microservices-root",
  "version": "1.0.0",
  "description": "Root control scripts for Bookstore Microservices with API Gateway",
  "scripts": {
    "start": "./start.sh",
    "stop": "./stop.sh",
    "restart": "./start.sh",
    "status": "./status.sh",
    "test:rate-limit": "./test-ratelimit.sh",
    "test:lb": "node test/load-test.js",
    "test:lb:stop": "pkill -f test/load-test.js || true",
    "test:concurrent": "node test/concurrent-test.js",
    "test:circuit": "node test/circuit-breaker-test.js",
    "test:circuit-unit": "node test/circuit-breaker-unit.js",
    "test:discovery": "node test/service-discovery-test.js",
    "demo:lb": "echo \"Run npm run test:lb -- order 10 in one terminal, and node test/send-requests.js in another.\""
  }
}